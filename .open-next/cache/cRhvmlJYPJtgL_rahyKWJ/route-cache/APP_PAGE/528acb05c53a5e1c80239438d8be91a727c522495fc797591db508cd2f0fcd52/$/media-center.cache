ages%2Fmedia%2Fdoha-summit.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fmedia%2Fdoha-summit.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fmedia%2Fdoha-summit.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fmedia%2Fdoha-summit.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fmedia%2Fdoha-summit.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fmedia%2Fdoha-summit.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fmedia%2Fdoha-summit.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"flex items-center justify-between text-xs mb-2\"><span class=\"text-amber-800 font-bold\">Doha, Qatar</span><span class=\"text-slate-400\">Oct 28, 2023</span></div><h3 class=\"text-xl font-serif text-slate-800 leading-snug mb-4\">Gulf Region Academic Summit</h3></div><div class=\"pt-4 border-t border-slate-100 text-xs text-slate-500 font-medium\">42<!-- --> Photos </div></div><div class=\"bg-white rounded-3xl p-6 border border-slate-200/90 shadow-2xs flex flex-col justify-between\"><div><div class=\"relative aspect-16/10 w-full rounded-2xl overflow-hidden bg-slate-100 mb-5\"><img alt=\"Annual Research Forum 2024\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fmedia%2Fkerala-forum.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fmedia%2Fkerala-forum.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fmedia%2Fkerala-forum.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fmedia%2Fkerala-forum.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fmedia%2Fkerala-forum.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fmedia%2Fkerala-forum.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fmedia%2Fkerala-forum.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fmedia%2Fkerala-forum.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fmedia%2Fkerala-forum.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"flex items-center justify-between text-xs mb-2\"><span class=\"text-amber-800 font-bold\">Kerala, India</span><span class=\"text-slate-400\">Mar 05, 2024</span></div><h3 class=\"text-xl font-serif text-slate-800 leading-snug mb-4\">Annual Research Forum 2024</h3></div><div class=\"pt-4 border-t border-slate-100 text-xs text-slate-500 font-medium\">64<!-- --> Photos <!-- -->• 2 Videos</div></div></div></section><section id=\"academic-events\" class=\"max-w-7xl mx-auto px-6 md:px-16 pt-16 md:pt-20\"><div class=\"mb-10\"><div class=\"flex items-center gap-2 mb-2\"><span class=\"w-6 h-0.5 bg-[#0c3823]\"></span><span class=\"text-[#0c3823] text-[11px] font-bold tracking-widest uppercase\">WORKSHOPS &amp; SEMINARS</span></div><h2 class=\"text-3xl sm:text-4xl font-serif text-slate-800 font-light mb-3\">Academic Events</h2><p class=\"text-xs sm:text-sm text-slate-600 font-normal\">Visual records of specialized training programs, exegesis workshops, and visiting scholar guest lectures.</p></div><div class=\"grid grid-cols-1 lg:grid-cols-2 gap-8\"><div class=\"bg-[#f7f4ed] rounded-3xl p-6 border border-amber-200/70 shadow-2xs flex flex-col sm:flex-row items-center gap-6\"><div class=\"relative w-full sm:w-44 aspect-square rounded-2xl overflow-hidden shrink-0 bg-slate-200\"><img alt=\"Research Methodology Workshop\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fmedia%2Fclassroom-workshop.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fmedia%2Fclassroom-workshop.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fmedia%2Fclassroom-workshop.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fmedia%2Fclassroom-workshop.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fmedia%2Fclassroom-workshop.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fmedia%2Fclassroom-workshop.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fmedia%2Fclassroom-workshop.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fmedia%2Fclassroom-workshop.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fmedia%2Fclassroom-workshop.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"flex-1 space-y-2\"><div class=\"flex items-center justify-between text-xs\"><span class=\"bg-emerald-100 text-[#0c3823] font-bold px-3 py-0.5 rounded-full uppercase text-[10px]\">Workshop</span><span class=\"text-slate-500 font-medium\">Jan 15, 2024</span></div><h3 class=\"text-lg font-serif text-slate-800 leading-snug\">Research Methodology Workshop</h3><p class=\"text-xs text-slate-600 leading-relaxed\">Equipping young exegesis researchers with rigorous classical and modern linguistic textual tools.</p></div></div><div class=\"bg-[#f7f4ed] rounded-3xl p-6 border border-amber-200/70 shadow-2xs flex flex-col sm:flex-row items-center gap-6\"><div class=\"relative w-full sm:w-44 aspect-square rounded-2xl overflow-hidden shrink-0 bg-slate-200\"><img alt=\"Manuscript Preservation Seminar\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fmedia%2Fpreservation-lab.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fmedia%2Fpreservation-lab.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fmedia%2Fpreservation-lab.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fmedia%2Fpreservation-lab.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fmedia%2Fpreservation-lab.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fmedia%2Fpreservation-lab.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fmedia%2Fpreservation-lab.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fmedia%2Fpreservation-lab.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fmedia%2Fpreservation-lab.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"flex-1 space-y-2\"><div class=\"flex items-center justify-between text-xs\"><span class=\"bg-emerald-100 text-[#0c3823] font-bold px-3 py-0.5 rounded-full uppercase text-[10px]\">Seminar</span><span class=\"text-slate-500 font-medium\">Nov 12, 2023</span></div><h3 class=\"text-lg font-serif text-slate-800 leading-snug\">Manuscript Preservation Seminar</h3><p class=\"text-xs text-slate-600 leading-relaxed\">An intensive seminar on the restoration, handling, and chemical mapping of historic parchments.</p></div></div><div class=\"bg-[#f7f4ed] rounded-3xl p-6 border border-amber-200/70 shadow-2xs flex flex-col sm:flex-row items-center gap-6\"><div class=\"relative w-full sm:w-44 aspect-square rounded-2xl overflow-hidden shrink-0 bg-slate-200\"><img alt=\"Doctoral Dissertation Symposium\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fmedia%2Fdoctoral-symposium.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fmedia%2Fdoctoral-symposium.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fmedia%2Fdoctoral-symposium.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fmedia%2Fdoctoral-symposium.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fmedia%2Fdoctoral-symposium.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fmedia%2Fdoctoral-symposium.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fmedia%2Fdoctoral-symposium.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fmedia%2Fdoctoral-symposium.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fmedia%2Fdoctoral-symposium.jpg&amp;w=3840