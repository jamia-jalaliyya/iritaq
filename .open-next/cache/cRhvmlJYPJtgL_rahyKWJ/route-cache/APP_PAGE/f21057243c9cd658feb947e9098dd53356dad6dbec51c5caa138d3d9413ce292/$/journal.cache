te-800 hover:text-emerald-800 transition-colors tracking-wide whitespace-nowrap\" href=\"/conference\">Conference</a></div><div class=\"relative text-center group\"><a class=\"inline-flex items-center justify-center py-1 text-xs font-semibold text-slate-800 hover:text-emerald-800 transition-colors tracking-wide whitespace-nowrap\" href=\"/contact\">Contact</a></div></nav></div><main class=\"flex-1\"><main class=\"w-full min-h-screen bg-slate-50 text-slate-800 font-sans py-12 px-6 sm:px-10\"><div class=\"max-w-5xl mx-auto space-y-12\"><nav class=\"flex items-center gap-2 text-xs text-amber-700 font-medium tracking-wide\"><div class=\"flex items-center gap-2\"><a class=\"hover:underline transition-colors\" href=\"/\">Home</a><span>&gt;</span></div><div class=\"flex items-center gap-2\"><a class=\"hover:underline transition-colors\" href=\"/journal\">Academic Journal</a></div></nav><div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center bg-white border border-slate-200/90 rounded-3xl p-8 sm:p-12 shadow-sm relative overflow-hidden\"><div class=\"absolute -right-10 -bottom-10 text-slate-100 pointer-events-none select-none\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open w-96 h-96 opacity-30\" aria-hidden=\"true\"><path d=\"M12 5v16\"></path><path d=\"M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z\"></path></svg></div><div class=\"lg:col-span-5 flex justify-center relative\"><div class=\"relative w-64 sm:w-72 h-96 bg-linear-to-br from-emerald-900 via-emerald-950 to-slate-900 text-amber-50 rounded-r-2xl rounded-l-md shadow-2xl p-6 flex flex-col justify-between border-l-4 border-amber-600 transform transition-transform duration-300 hover:scale-[1.02]\"><div class=\"absolute left-0 top-0 bottom-0 w-3 bg-black/20 rounded-l-md\"></div><div class=\"space-y-3 z-10\"><div class=\"flex justify-between items-center text-[10px] tracking-widest uppercase text-amber-400 font-semibold border-b border-amber-500/30 pb-2\"><span>Peer-Reviewed</span></div><div><span class=\"text-[10px] text-emerald-300 uppercase tracking-wider block\">Iritaq Publication</span><h3 class=\"font-serif text-lg font-bold text-white leading-tight mt-1\">International Journal of Tafsir and Qur&#x27;anic Studies</h3></div></div><div class=\"my-auto py-4 flex flex-col items-center justify-center text-center z-10\"><div class=\"w-16 h-16 rounded-full border border-amber-500/40 bg-amber-500/10 flex items-center justify-center text-amber-400 mb-2 shadow-inner\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-award w-8 h-8\" aria-hidden=\"true\"><path d=\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\"></path><circle cx=\"12\" cy=\"8\" r=\"6\"></circle></svg></div><span class=\"text-[11px] font-serif tracking-widest text-amber-200/80 uppercase\">Scholarly Discourse</span></div><div class=\"pt-3 border-t border-amber-500/30 flex justify-between items-end text-[10px] text-slate-300 z-10\"><div><p class=\"font-semibold text-white\">Academic Periodical</p><p class=\"text-amber-400\">Open Access Edition</p></div><span class=\"bg-amber-500 text-slate-950 font-bold px-2 py-0.5 rounded text-[9px] uppercase tracking-wider\">Online</span></div></div></div><div class=\"lg:col-span-7 space-y-6 z-10\"><div class=\"inline-flex items-center gap-2 bg-emerald-50 text-emerald-700 px-4 py-1.5 rounded-full text-xs font-bold tracking-wide uppercase border border-emerald-200\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open w-3.5 h-3.5\" aria-hidden=\"true\"><path d=\"M12 5v16\"></path><path d=\"M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z\"></path></svg><span>Majallah Al-Iritaq for Islamic Studies (MJIS)</span></div><h1 class=\"text-3xl sm:text-4xl font-serif font-bold tracking-tight text-slate-900\">Jamia Jalaliyya Academic Journal</h1><p class=\"text-sm sm:text-base text-slate-600 leading-relaxed\">Advancing scholarly research, contemporary Islamic studies, humanities, and multidisciplinary academic discourse through rigorous peer review.</p><div class=\"grid grid-cols-2 sm:grid-cols-3 gap-4 pt-2 border-t border-slate-100\"><div><span class=\"text-[11px] text-slate-500 block uppercase\">Review Process</span><span class=\"text-xs font-bold text-slate-800\">Double-Blind</span></div><div><span class=\"text-[11px] text-slate-500 block uppercase\">Format</span><span class=\"text-xs font-bold text-slate-800\">Digital Portal</span></div><div><span class=\"text-[11px] text-slate-500 block uppercase\">Access Type</span><span class=\"text-xs font-bold text-slate-800\">Open Access</span></div></div><div class=\"pt-2 flex flex-wrap items-center gap-4\"><a target=\"_blank\" rel=\"noopener noreferrer\" class=\"bg-emerald-800 hover:bg-emerald-900 text-white font-bold px-8 py-3.5 rounded-2xl text-sm flex items-center gap-2 shadow-lg transition transform hover:-translate-y-0.5\" href=\"https://journal.iritaq.info/index.php/mjis/en\"><span>Explore Journal Portal</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link w-4 h-4\" aria-hidden=\"true\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></div></div></div><div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 pt-4\"><div class=\"bg-white border border-slate-200/90 rounded-3xl p-6 space-y-3 shadow-sm\"><div class=\"w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-800\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-award w-5 h-5\" aria-hidden=\"true\"><path d=\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\"></path><circle cx=\"12\" cy=\"8\" r=\"6\"></circle></svg></div><h2 class=\"font-bold text-base text-slate-900\">High Academic Standards</h2><p class=\"text-xs text-slate-600 leading-relaxed\">Committed to publishing original, high-quality research contributions evaluated by expert double-blind reviewers.</p></div><div class=\"bg-white border border-slate-200/90 rounded-3xl p-6 space-y-3 shadow-sm\"><div class=\"w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-800\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users w-5 h-5\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg></div><h2 class=\"font-bold text-base text-slate-900\">Global Editorial Board</h2><p class=\"text-xs text-slate-600 leading-relaxed\">Guided by distinguished scholars, researchers, and academicians from prominent universities worldwide.</p></div><div class=\"bg-white border border-slate-200/90 rounded-3xl p-6 space-y-3 shadow-sm\"><div class=\"w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-800\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-text w-5 h-5\" aria-hidden=\"true\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"></path><path d=\"M14 2v5a1 1 0 0 0 1 1h5\"></path><path d=\"M10 9H8\"></path><path d=\"M16 13H8\"></path><path d=\"M16 17H8\"></path></svg></div><h2 class=\"font-bold text-base text-slate-900\">Open Access Policy</h2><p class=\"text-xs text-slate-600 leading-relaxed\">Providing unrestricted global online access to scholarly outputs to encourage knowledge sharing and academic growth.</p></div></div><div class=\"bg-white border border-slate-200/90 rounded-3xl p-8 sm:p-10 shadow-sm space-y-6\"><h2 class=\"text-xl font-serif font-bold border-b border-slate-100 pb-4 text-slate-900\">Focus &amp; Scope</h2><p class=\"text-xs sm:text-sm text-slate-600 leading-relaxed\">The journal serves as a premier platform for academics, researchers, and students to publish findings covering a wide array of disciplines including Islamic jurisprudence, philosophy, contemporary social sciences, Arabic-English literature, and historical studies.</p><div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2\"><div class=\"flex items-center gap-3 text-xs sm:text-sm font-medium text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check lucide-check-circle-2 w-4 h-4 text-emerald-700 shrink-0\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m16 9-5.5 5.5L8 12\"></path></svg><span>Islamic Jurisprudence &amp; Usul al-Fiqh</span></div><div class=\"flex items-center gap-3 text-xs sm:text-sm font-medium text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check lucide-check-circle-2 w-4 h-4 text-emerald-700 shrink-0\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m16 9-5.5 5.5L8 12\"></path></svg><span>Comparative Religious Studies</span></div><div class=\"flex items-center gap-3 text-xs sm:text-sm font-medium text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check lucide-check-circle-2 w-4 h-4 text-emerald-700 shrink-0\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m16 9-5.5 5.5L8 12\"></path></svg><span>Arabic Language &amp; Literature</span></div><div class=\"flex items-center gap-3 text-xs sm:text-sm font-medium text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check lucide-check-circle-2 w-4 h-4 text-emerald-700 shrink-0\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m16 9-5.5 5.5L8 12\"></path></svg><span>Contemporary Social Sciences</span></div><div class=\"flex items-center gap-3 text-xs sm:text-sm font-medium text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check luc