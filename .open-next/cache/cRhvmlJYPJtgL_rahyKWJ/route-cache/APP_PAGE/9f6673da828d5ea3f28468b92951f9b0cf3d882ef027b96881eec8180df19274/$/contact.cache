rrentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z\"></path></svg><span>+91 800 123 0003</span></a></div></div><div class=\"border border-gray-200/80 rounded-xl p-6 bg-white hover:shadow-md transition-shadow flex flex-col justify-between\"><div><div class=\"w-10 h-10 rounded-lg bg-[#FAF5EC] flex items-center justify-center mb-5\"><svg class=\"w-5 h-5 text-[#C5A059]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9\"></path></svg></div><h3 class=\"text-base font-serif text-[#1E3E34] font-medium mb-2.5\">International Relations</h3><p class=\"text-xs text-gray-500 leading-relaxed font-light mb-6\">Managing agreements, international MoU execution, visiting scholar visas, and global academic networks.</p></div><div class=\"space-y-2 border-t border-gray-100 pt-4 text-xs font-medium\"><a href=\"mailto:relations@iritaq.edu.in\" class=\"flex items-center text-[#21674E] hover:underline truncate\"><svg class=\"w-3.5 h-3.5 mr-2 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z\"></path></svg><span class=\"truncate\">relations@iritaq.edu.in</span></a><a href=\"tel:+91 800 123 0004\" class=\"flex items-center text-gray-600 hover:text-gray-900 truncate\"><svg class=\"w-3.5 h-3.5 mr-2 shrink-0 text-[#C5A059]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z\"></path></svg><span>+91 800 123 0004</span></a></div></div><div class=\"border border-gray-200/80 rounded-xl p-6 bg-white hover:shadow-md transition-shadow flex flex-col justify-between\"><div><div class=\"w-10 h-10 rounded-lg bg-[#FAF5EC] flex items-center justify-center mb-5\"><svg class=\"w-5 h-5 text-[#C5A059]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z\"></path></svg></div><h3 class=\"text-base font-serif text-[#1E3E34] font-medium mb-2.5\">Publications &amp; Journals</h3><p class=\"text-xs text-gray-500 leading-relaxed font-light mb-6\">Enquiries regarding manuscript submissions, peer-review cycles, journal subscriptions, and Digital Library licensing.</p></div><div class=\"space-y-2 border-t border-gray-100 pt-4 text-xs font-medium\"><a href=\"mailto:publications@iritaq.edu.in\" class=\"flex items-center text-[#21674E] hover:underline truncate\"><svg class=\"w-3.5 h-3.5 mr-2 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z\"></path></svg><span class=\"truncate\">publications@iritaq.edu.in</span></a><a href=\"tel:+91 800 123 0005\" class=\"flex items-center text-gray-600 hover:text-gray-900 truncate\"><svg class=\"w-3.5 h-3.5 mr-2 shrink-0 text-[#C5A059]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z\"></path></svg><span>+91 800 123 0005</span></a></div></div><div class=\"border border-gray-200/80 rounded-xl p-6 bg-white hover:shadow-md transition-shadow flex flex-col justify-between\"><div><div class=\"w-10 h-10 rounded-lg bg-[#FAF5EC] flex items-center justify-center mb-5\"><svg class=\"w-5 h-5 text-[#C5A059]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M12 14l9-5-9-5-9 5 9 5z\"></path><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 01-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z\"></path></svg></div><h3 class=\"text-base font-serif text-[#1E3E34] font-medium mb-2.5\">Admissions &amp; Registrar</h3><p class=\"text-xs text-gray-500 leading-relaxed font-light mb-6\">For prospective students, admissions requirements, applications, scholarship quotas, and student registration.</p></div><div class=\"space-y-2 border-t border-gray-100 pt-4 text-xs font-medium\"><a href=\"mailto:admissions@iritaq.edu.in\" class=\"flex items-center text-[#21674E] hover:underline truncate\"><svg class=\"w-3.5 h-3.5 mr-2 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z\"></path></svg><span class=\"truncate\">admissions@iritaq.edu.in</span></a><a href=\"tel:+91 800 123 0006\" class=\"flex items-center text-gray-600 hover:text-gray-900 truncate\"><svg class=\"w-3.5 h-3.5 mr-2 shrink-0 text-[#C5A059]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z\"></path></svg><span>+91 800 123 0006</span></a></div></div><div class=\"border border-gray-200/80 rounded-xl p-6 bg-white hover:shadow-md transition-shadow flex flex-col justify-between\"><div><div class=\"w-10 h-10 rounded-lg bg-[#FAF5EC] flex items-center justify-center mb-5\"><svg class=\"w-5 h-5 text-[#C5A059]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c.41 0 .789-.252.95-.63l1.107-2.585A1 1 0 0111.81 2h.38a1 1 0 011 1v18a1 1 0 01-1 1h-.38a1 1 0 01-.922-.615l-1.107-2.585A1.001 1.001 0 008.832 18H7a4 4 0 01-1.564-.317z\"></path></svg></div><h3 class=\"text-base font-serif text-[#1E3E34] font-medium mb-2.5\">Media &amp; Communications</h3><p class=\"text-xs text-gray-500 leading-relaxed font-light mb-6\">Handling press releases, event announcements, broadcasting permits, guest lecture recordings, and public relations.</p></div><div class=\"space-y-2 border-t border-gray-100 pt-4 text-xs font-medium\"><a href=\"mailto:media@iritaq.edu.in\" class=\"flex items-center text-[#21674E] hover:underline truncate\"><svg class=\"w-3.5 h-3.5 mr-2 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z\"></path></svg><span class=\"truncate\">media@iritaq.edu.in</span></a><a href=\"tel:+91 800 123 0007\" class=\"flex items-center text-gray-600 hover:text-gray-900 truncate\"><svg class=\"w-3.5 h-3.5 mr-2 shrink-0 text-[#C5A059]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z\"></path></svg><span>+91 800 123 0007</span></a></div></div></div></div></section><section id=\"enquiry-form\" class=\"py-16 sm:py-20 bg-[#F7F7F7] border-t border-gray-100\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"grid grid-cols-1 lg:grid-cols-12 gap-10\"><div class=\"lg:col-span-7\"><div class=\"mb-8\"><div class=\"flex items-center space-x-3 mb-2\"><span class=\"h-px w-8 bg-[#C5A059]\"></span><span class=\"text-xs uppercase tracking-widest text-[#21674E] font-semibold\">OFFICIAL ENQUIRY FORM</span></div><h2 class=\"text-2xl sm:text-3xl font-serif font-normal text-[#1E3E34] mb-3\">Official Enquiry Form</h2><p class=\"text-gray-600 text-xs sm:text-sm font-light leading-relaxed\">Please populate the field entries below. All submissions are directed to respective departments instantly.</p></div><form class=\"space-y-4\"><div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\"><div><label class=\"block text-xs font-semibold text-gray-700 mb-1\">Name *</label><input type=\"text\" required=\"\" placeholder=\"Your full name\" class=\"w-full px-3.5 py-2.5 bg-white border border-gray-200 rounded text-xs text-gray-800 focus:outline-none focus:border-[#1E3E34]\" name=\"name\" value=\"\"/></div><div><label class=\"block text-xs font-semibold text-gray-700 mb-1\">Email Address *</label><input type=\"email\" required=\"\" placeholder=\"e.g. name@domain.com\" class=\"w-full px-3.5 py-2.5 bg-white border border-gray-200 rounded text-xs text-gray-800 focus:outline-none focus:border-[#1E3E34]\" name=\"email\" value=\"\"/></div></div><div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\"><div><label class=\"block text-xs font-semibold text-gray-700 mb-1\">Phone Number</label><input type=\"tel\" placeholder=\"Include country code\" class=\"w-full px-3.5 py-2.5 bg-white border border-gray-200 rounded text-xs text-gray-800 focus:outline-none focus:border-[#1E3E34]\" name=\"phone\" value=\"\"/></div><div><label class=\"block text-xs font-semibold text-gray-700 mb-1\">Organisation / University</label><input type=\"text\" placeholder=\"e.g. Al-Azhar University\" class=\"w-full px-3.5 py-2.5 bg-white border border-gray-200 rounded text-xs text-gray-800 focus:outline-none focus:border-[#1E3E34]\" name=\"organisation\" value=\"\"/></div></div><div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\"><div><label class=\"block text-xs font-semibold text-gray-700 mb-1\">Country</label><select name=\"country\" class=\"w-full px-3.5 py-2.5 bg-white border border-gray-200 rounded text-xs text-gray-700 focus:outline-none focus:border-[#1E3E34]\"><option value=\"\" selected=\"\">Select your country</option><option value=\"IN\">India</option><option value=\"SA\">Saudi Arabia</option><option value=\"UAE\">United Arab Emirates</option><option value=\"UK\">United Kingdom</option><option value=\"US\">United States</option><option value=\"EG\">Egypt</option></select></div><div><label class=\"block text-xs font-semibold text-gray-700 mb-1\">Subject of Inquiry</label><select name=\"subject\" class=\"w-full px-3.5 py-2.5 bg-white border border-gray-200 rounded text-xs text-gray-700 focus:outline-none focus:border-[#1E3E34]\"><option value=\"\" selected=\"\">Choose a department category</option><option value=\"general\">General Enquiries</option><option value=\"academics\">Academic Affairs</option><option value=\"research\">Research Enquiries</option><option value=\"relations\">International Relations</option><option value=\"publications\">Publications &amp; Journals</option><option value=\"admissions\">Admissions &amp; Registrar</option><option value=\"media\">Media &amp; Communications</option></select></div></div><div><label class=\"block text-xs font-semibold text-gray-700 mb-1\">Your Message *</label><textarea rows=\"5\" name=\"message\" required=\"\" placeholder=\"Describe the details of your inquiry, collaboration request, or questions...\" class=\"w-full px-3.5 py-2.5 bg-white border border-gray-200 rounded text-xs text-gray-800 focus:outline-none focus:border-[#1E3E34] resize-y\"></textarea></div><div><label class=\"block text-xs font-semibold text-gray-700 mb-1\">Supporting Documents (Optional)</label><div class=\"border border-dashed border-[#C5A059]/70 rounded-lg p-6 bg-white/50 text-center flex flex-col items-center justify-center cursor-pointer hover:bg-white transition-colors relative\"><input type=\"file\" class=\"absolute inset-0 opacity-0 cursor-pointer\"/><svg class=\"w-6 h-6 text-[#C5A059] mb-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12\"></path></svg><span class=\"text-xs font-semibold text-gray-800\">Drag &amp; Drop files here, or click to upload</span><span class=\"text-[11px] text-gray-400 mt-0.5\">PDF, DOCX, or JPEG up to 10MB</span></div></div><div class=\"pt-2\"><button type=\"submit\" class=\"inline-flex items-center gap-2 px-8 py-3 bg-[#132821] hover:bg-[#0C1714] text-white text-xs font-semibold rounded-full transition-colors duration-200 cursor-pointer disabled:opacity-50\"><span>Submit Enquiry</span></button></div></form></div><div class=\"lg:col-span-5 space-y-6\"><div class=\"bg-white border border-gray-200 rounded-xl p-6 shadow-xs\"><h3 class=\"text-lg font-serif text-[#1E3E34] font-medium mb-4\">Our Main Campus</h3><div class=\"space-y-3.5 text-xs text-gray-600\"><div class=\"flex items-start\"><svg class=\"w-4 h-4 text-[#C5A059] mr-3 shrink-0 mt-0.5\" fill=\"none\" stroke=\