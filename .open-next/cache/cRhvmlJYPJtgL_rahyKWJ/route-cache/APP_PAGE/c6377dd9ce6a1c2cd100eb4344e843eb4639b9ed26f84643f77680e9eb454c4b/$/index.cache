F%2Fbgwjlhoyzwzwavftromg.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Firitaq-media%2Fhome%2F1793027962225-85vzp57.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fbgwjlhoyzwzwavftromg.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Firitaq-media%2Fhome%2F1793027962225-85vzp57.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fbgwjlhoyzwzwavftromg.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Firitaq-media%2Fhome%2F1793027962225-85vzp57.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fbgwjlhoyzwzwavftromg.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Firitaq-media%2Fhome%2F1793027962225-85vzp57.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fbgwjlhoyzwzwavftromg.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Firitaq-media%2Fhome%2F1793027962225-85vzp57.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fbgwjlhoyzwzwavftromg.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Firitaq-media%2Fhome%2F1793027962225-85vzp57.png&amp;w=3840&amp;q=75\"/><div class=\"relative z-10 max-w-5xl mx-auto text-left w-full\"><div class=\"flex items-center gap-2 mb-4 text-xs md:text-sm tracking-widest text-amber-400 font-semibold uppercase\"><span class=\"w-8 h-0.5 bg-amber-400 inline-block\"></span>INTERNATIONAL RESEARCH INSTITUTE FOR TAFSIR AL-QUR&#x27;AN</div><h1 class=\"text-4xl md:text-6xl font-serif font-normal leading-tight mb-6\">Advancing Qur&#x27;an Scholarship</h1><p class=\"text-lg md:text-xl text-slate-200 max-w-2xl mb-8 font-light\">IRITAQ is a global centre for advanced research in Tafsir, Qur&#x27;anic Sciences and Islamic knowledge.</p><div class=\"flex flex-wrap gap-4\"><a class=\"bg-emerald-700 hover:bg-emerald-800 text-white px-6 py-3 rounded-full font-medium transition flex items-center gap-2 text-sm\" href=\"/contact\">Join Community<!-- --> <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right w-4 h-4\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></a><a class=\"border border-white/60 hover:bg-white/10 text-white px-6 py-3 rounded-full font-medium transition flex items-center gap-2 text-sm\" href=\"/research\">Explore Research<!-- --> <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right w-4 h-4\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></a></div></div></section></div><div class=\"w-full mx-auto px-4 pt-6\"><div class=\"bg-neutral-900 text-white rounded-xl flex items-stretch overflow-hidden shadow-md\"><div class=\"bg-emerald-700 px-6 py-3 font-semibold text-xs tracking-wider uppercase flex items-center gap-2 shrink-0 self-stretch z-10 shadow-md\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-megaphone w-4 h-4\" aria-hidden=\"true\"><path d=\"M11 6a13 13 0 0 0 8.4-2.8A1 1 0 0 1 21 4v12a1 1 0 0 1-1.6.8A13 13 0 0 0 11 14H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z\"></path><path d=\"M6 14a12 12 0 0 0 2.4 7.2 2 2 0 0 0 3.2-2.4A8 8 0 0 1 10 14\"></path><path d=\"M8 6v8\"></path></svg> Announcement</div><div class=\"relative flex overflow-hidden items-center w-full py-3\"><div class=\"flex whitespace-nowrap animate-marquee hover:[animation-play-state:paused] text-xs md:text-sm text-slate-300 font-medium\"><span class=\"px-4\">IRITAQ International Conference on Qur&#x27;anic Sciences — Registration Now Open • New Announcement<!-- --> •</span><span class=\"px-4\">IRITAQ International Conference on Qur&#x27;anic Sciences — Registration Now Open • New Announcement<!-- --> •</span></div></div></div></div><section class=\"py-24 w-full mx-auto px-6\"><div class=\"grid md:grid-cols-2 gap-12 items-center\"><div class=\"relative h-100 md:h-120 rounded-2xl overflow-hidden shadow-xl\"><img alt=\"Welcome Desktop\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"hidden md:block object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fwel.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fwel.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fwel.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fwel.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fwel.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fwel.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fwel.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fwel.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fwel.png&amp;w=3840&amp;q=75\"/><img alt=\"Welcome Mobile\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"block md:hidden object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fwel.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fwel.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fwel.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fwel.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fwel.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fwel.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fwel.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fwel.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fwel.png&amp;w=3840&amp;q=75\"/></div><div><div class=\"flex items-center gap-2 mb-3 text-xs tracking-widest text-emerald-700 font-semibold uppercase\"><span class=\"w-8 h-0.5 bg-emerald-700 inline-block\"></span>WELCOME TO IRITAQ</div><h2 class=\"text-3xl md:text-5xl font-serif text-slate-900 mb-6 leading-snug\">A Global Centre for Qur&#x27;anic Scholarship</h2><p class=\"text-slate-600 leading-relaxed text-sm md:text-base mb-8\">The International Research Institute for Tafsir al-Qur&#x27;an (IRITAQ) is an international academic and research institution established under the auspices of Al-Jamia Al-Jalaliyya. The Institute is dedicated to advancing authentic scholarship in Tafsir and Qur&#x27;anic Sciences and related disciplines, while fostering international collaboration, scholarly publications and innovative research for the benefit of humanity.</p><a class=\"inline-flex items-center gap-2 bg-emerald-700 hover:bg-emerald-800 text-white px-6 py-3 rounded-full font-medium text-sm transition\" href=\"/about\">Read More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right w-4 h-4\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></a></div></div></section><div class=\"w-full mx-auto px-4 py-12 md:py-16\"><section class=\"relative text-white rounded-2xl md:rounded-3xl overflow-hidden shadow-xl border border-slate-200/20 py-12 md:py-16 px-6 md:px-12\"><img alt=\"Patron Background Desktop\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"hidden md:block object-cover brightness-[0.25]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fpatronbg.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fpatronbg.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fpatronbg.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fpatronbg.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fpatronbg.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fpatronbg.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fpatronbg.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fpatronbg.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fpatronbg.png&amp;w=3840&amp;q=75\"/><img alt=\"Patron Background Mobile\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"block md:hidden object-cover brightness-[0.25]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fpatronbg.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fpatronbg.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fpatronbg.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fpatronbg.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fpatronbg.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fpatronbg.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fpatronbg.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fpatronbg.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fpatronbg.png&amp;w=3840&amp;q=75\"/><div class=\"relative z-10 max-w-6xl mx-auto\"><div class=\"bg-neutral-900/60 backdrop-blur-md rounded-2xl p-8 md:p-12 border border-white/10 grid md:grid-cols-12 gap-8 items-center\"><div class=\"md:col-span-4 relative h-72 w-full rounded-2xl overflow-hidden border-2 border-emerald-600/50\"><img alt=\"Sayyid Muhammad Jifri Muthu Koya Thangal\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"hidden md:block object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fthangalusthad.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fthangalusthad.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fthangalusthad.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fthangalusthad.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fthangalusthad.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fthangalusthad.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fthangalusthad.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fthangalusthad.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fthangalusthad.png&amp;w=3840&amp;q=75\"/><img alt=\"Sayyid Muhammad Jifri Muthu Koya Thangal\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"block md:hidden object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fthangalusthad.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fthangalusthad.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fthangalusthad.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fthangalusthad.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fthangalusthad.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fthangalusthad.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fthangalusthad.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fthangalusthad.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fthangalusthad.png&amp;w=3840&amp;q=75\"/></div><div class=\"md:col-span-8\"><div class=\"flex items-center gap-2 mb-2 text-xs tracking-widest text-amber-400 font-semibold uppercase\"><span class=\"w-8 h-0.5 bg-amber-400 inline-block\"></span>GRAND PATRON</div><h3 class=\"text-2xl md:text-3xl font-serif text-amber-200 mb-4\">&quot;Message from the Grand Patron&quot;</h3><p class=\"text-slate-300 text-sm md:text-base leading-relaxed mb-6 font-light\">IRITAQ was established with a clear vision to promote authentic Qur&#x27;anic scholarship, strengthen academic research and build international partnerships among universities and research institutions. We aspire to become a global platform where knowledge, innovation and faith come together in the service of the Holy Qur&#x27;an. We warmly invite scholars, researchers and institutions worldwide to join us in this noble academic mission.</p><div><h4 class=\"text-lg font-serif text-white\">Sayyid Muhammad Jifri Muthu Koya Thangal</h4><p class=\"text-xs tracking-wider text-amber-400 font-medium uppercase mt-1\">GRAND PATRON</p></div></div></div></div></section></div><section class=\"py-20 px-6 max-w-7xl mx-auto\"><div class=\"max-w-6xl mx-auto text-center mb-16\"><div class=\"flex items-center justify-center gap-2 mb-2 text-xs tracking-widest text-amber-700 font-semibold uppercase\"><span class=\"w-8 h-0.5 bg-amber-700 inline-block\"></span>VISION &amp; MISSION<span class=\"w-8 h-0.5 bg-amber-700 inline-block\"></span></div><h2 class=\"text-3xl md:text-5xl font-serif text-slate-900\">Purpose That Anchors Every Programme</h2></div><div class=\"max-w-6xl mx-auto grid md:grid-cols-2 gap-8\"><div class=\"bg-white p-8 md:p-10 rounded-2xl shadow-sm border border-slate-200/80 hover:border-amber-700/30 transition\"><h3 class=\"text-2xl font-serif text-amber-700 mb-4\">Our Vision</h3><p class=\"text-slate-600 leading-relaxed text-sm md:text-base\">To become a globally recognized centre of excellence and an authoritative reference in Tafsir al-Qur&#x27;an and Qur&#x27;anic Studies through academic leadership, pioneering research and international collaboration.</p></div><div class=\"bg-white p-8 md:p-10 rounded-2xl shadow-sm border border-slate-200/80 hover:border-amber-700/30 transition\"><h3 class=\"text-2xl font-serif text-amber-700 mb-4\">Our Mission</h3><p class=\"text-slate-600 leading-relaxed text-sm md:text-base\">To advance authentic Qur&#x27;anic scholarship through innovative research, academic excellence, international cooperation, scholarly publications and advanced educational programs, while preparing future generations of researchers dedicated to serving the Holy Qur&#x27;an and humanity.</p></div></div></section><section class=\"py-24 max-w-7xl mx-auto px-6\"><div class=\"grid lg:grid-cols-12 gap-12\"><div class=\"lg:col-span-4\"><h2 class=\"text-3xl md:text-4xl font-serif text-slate-900 mb-4\">Research Domains</h2><p class=\"text-slate-600 text-sm md:text-base leading-relaxed\">Discover groundbreaking research that bridges Islamic heritage with contemporary knowledge, fostering innovation, academic excellence and global collaboration.</p></div><div class=\"lg:col-span-8 grid sm:grid-cols-2 md:grid-cols-3 gap-4\"><div class=\"bg-neutral-900 text-white p-6 rounded-xl hover:bg-neutral-800 transition group cursor-pointer flex flex-col justify-between min-h-30\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open w-5 h-5 text-amber-400 mb-4\" aria-hidden=\"true\"><path d=\"M12 5v16\"></path><path d=\"M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z\"></path></svg><span class=\"font-serif text-sm tracking-wide group-hover:text-amber-200 transition\">Tafsir Studies</span></div><div class=\"bg-neutral-900 text-white p-6 rounded-xl hover:bg-neutral-800 transition group cursor-pointer flex flex-col justify-between min-h-30\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open w-5 h-5 text-amber-400 mb-4\" aria-hidden=\"true\"><path d=\"M12 5v16\"></path><path d=\"M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z\"></path></svg><span class=\"font-serif text-sm tracking-wide group-hover:text-amber-200 transition\">Qur&#x27;anic Sciences</span></div><div class=\"bg-neutral-900 text-white p-6 rounded-xl hover:bg-neutral-800 transition group cursor-pointer flex flex-col justify-between min-h-30\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open w-5 h-5 text-amber-400 mb-4\" aria-hidden=\"true\"><path d=\"M12 5v16\"></path><path d=\"M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4