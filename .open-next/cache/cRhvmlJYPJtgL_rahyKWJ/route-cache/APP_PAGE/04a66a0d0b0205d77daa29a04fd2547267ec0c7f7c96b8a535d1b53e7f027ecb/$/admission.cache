\":\"req-4\",\"title\":\"Research Proposal\",\"number\":\"04\",\"description\":\"A comprehensive 1500-word draft detailing research questions, targeted texts, and methodologies (Fellows only).\"},{\"id\":\"req-5\",\"title\":\"Letters of Recommendation\",\"number\":\"05\",\"description\":\"Two signed academic endorsements from accredited departments confirming historical integrity and drive.\"},{\"id\":\"req-6\",\"title\":\"Statement of Purpose\",\"number\":\"06\",\"description\":\"A personal letter detailing your academic journey, targets, and reasons for choosing IRITAQ.\"}],\"steps\":[{\"title\":\"Create Account\",\"stepNumber\":\"STEP 01\",\"description\":\"Register an applicant account on the official portal using verified contact emails.\"},{\"title\":\"Fill Forms\",\"stepNumber\":\"STEP 02\",\"description\":\"Input details, select target courses, and outline previous scholarly backgrounds carefully.\"},{\"title\":\"Upload Materials\",\"stepNumber\":\"STEP 03\",\"description\":\"Submit high-resolution PDFs of ID sheets, official degree transcripts, and references.\"},{\"title\":\"Review & Pay\",\"stepNumber\":\"STEP 04\",\"description\":\"Double-check overall details, process the digital administrative fee, and receive confirmation.\"}],\"deadlines\":[{\"items\":[{\"date\":\"January 01, 2026\",\"event\":\"Admissions Open:\"},{\"date\":\"February 28, 2026\",\"event\":\"Early Action Deadline:\"},{\"date\":\"March 15, 2026\",\"event\":\"General Deadline:\"}],\"category\":\"JANUARY TERM\"},{\"items\":[{\"date\":\"April 1–15, 2026\",\"event\":\"Scholarly Interviews:\"},{\"date\":\"May 01, 2026\",\"event\":\"Final Decisions Out:\"},{\"date\":\"September 01, 2026\",\"event\":\"Classes Inauguration:\"}],\"category\":\"INTERVIEWS & INTAKE\"}],\"faqs\":[{\"answer\":\"You may select up to two program choices on a single registration track. However, you must highlight a primary preference and submit a dedicated research overview for your highest option.\",\"question\":\"Ca