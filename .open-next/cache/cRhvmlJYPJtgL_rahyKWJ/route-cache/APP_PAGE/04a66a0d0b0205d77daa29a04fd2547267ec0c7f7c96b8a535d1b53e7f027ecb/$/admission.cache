.jpe&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Flib.jpe&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Flib.jpe&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Flib.jpe&amp;w=3840&amp;q=75\"/><img alt=\"Visiting Scholars\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"block md:hidden object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Flib.jpe&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Flib.jpe&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Flib.jpe&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Flib.jpe&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Flib.jpe&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Flib.jpe&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Flib.jpe&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Flib.jpe&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Flib.jpe&amp;w=3840&amp;q=75\"/></div><div class=\"flex flex-col justify-between\"><div><span class=\"text-[10px] font-bold tracking-wider text-[#C5A059] uppercase block mb-1\">ADMISSIONS OPEN</span><h3 class=\"text-lg font-serif text-[#1E3E34] font-medium mb-1\">Visiting Scholars</h3><p class=\"text-xs text-[#1E3E34]/80 font-serif mb-2\" dir=\"rtl\">العلماء الزائرون</p><p class=\"text-xs text-gray-500 line-clamp-3 leading-relaxed\">Collaborative residential frameworks for international academics conducting comparative research.</p></div><a href=\"#apply\" class=\"text-xs font-semibold text-[#1E3E34] hover:underline inline-flex items-center mt-3\">Apply Now <span class=\"ml-1\">→</span></a></div></div><div class=\"border border-gray-200 rounded-lg p-5 flex space-x-4 bg-white hover:shadow-md transition-shadow\"><div class=\"relative w-24 h-32 shrink-0 overflow-hidden rounded\"><img alt=\"Research Internships\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"hidden md:block object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Flib.jpe&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Flib.jpe&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Flib.jpe&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Flib.jpe&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Flib.jpe&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Flib.jpe&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Flib.jpe&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Flib.jpe&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Flib.jpe&amp;w=3840&amp;q=75\"/><img alt=\"Research Internships\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"block md:hidden object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Flib.jpe&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Flib.jpe&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Flib.jpe&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Flib.jpe&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Flib.jpe&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Flib.jpe&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Flib.jpe&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Flib.jpe&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Flib.jpe&amp;w=3840&amp;q=75\"/></div><div class=\"flex flex-col justify-between\"><div><span class=\"text-[10px] font-bold tracking-wider text-[#C5A059] uppercase block mb-1\">ADMISSIONS OPEN</span><h3 class=\"text-lg font-serif text-[#1E3E34] font-medium mb-1\">Research Internships</h3><p class=\"text-xs text-[#1E3E34]/80 font-serif mb-2\" dir=\"rtl\">التدريب البحثي</p><p class=\"text-xs text-gray-500 line-clamp-3 leading-relaxed\">Hands-on assistantships paired directly with leading faculty on ongoing digital database indexing.</p></div><a href=\"#apply\" class=\"text-xs font-semibold text-[#1E3E34] hover:underline inline-flex items-center mt-3\">Apply Now <span class=\"ml-1\">→</span></a></div></div></div></div></section><section class=\"pt-4 sm:pt-6 lg:pt-8 px-4 sm:px-4 lg:px-4\"><div class=\"w-full mx-auto bg-[#1E3E34] text-white rounded-2xl lg:rounded-3xl shadow-xl overflow-hidden p-6 sm:p-10 lg:p-12\"><div class=\"flex flex-col lg:flex-row lg:items-end justify-between mb-10 gap-6\"><div><div class=\"flex items-center space-x-3 mb-3\"><span class=\"h-px w-8 bg-[#C5A059]\"></span><span class=\"text-xs uppercase tracking-widest text-[#C5A059] font-semibold\">FEATURED PROGRAM</span></div><h2 class=\"text-3xl sm:text-4xl font-serif font-normal text-white mb-3\">Master of Qur&#x27;anic Sciences</h2><p class=\"text-gray-300 text-sm max-w-2xl font-light\">A premier graduate program exploring the hermeneutics of classical commentary, early manuscripts palaeography, and linguistic systems.</p></div><div class=\"flex flex-wrap gap-3\"><a href=\"#apply\" class=\"px-5 py-3 bg-[#C5A059] hover:bg-[#D4B87C] text-[#132821] text-xs font-bold rounded transition-colors\">Apply for Masters</a></div></div><div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\"><div class=\"bg-white/5 border border-white/10 rounded-xl p-6\"><span class=\"text-[10px] tracking-widest text-[#C5A059] uppercase block mb-3 font-semibold\">DURATION &amp; TERM</span><h3 class=\"text-2xl font-serif text-white font-normal mb-2\">2 Academic Years</h3><p class=\"text-xs text-gray-300 leading-relaxed font-light\">Four full terms including a compulsory thesis submission.</p></div><div class=\"bg-white/5 border border-white/10 rounded-lg p-6\"><span class=\"text-[10px] tracking-widest text-[#C5A059] uppercase block mb-3 font-semibold\">PREREQUISITE ELIGIBILITY</span><h3 class=\"text-2xl font-serif text-white font-normal mb-2\">Bachelor&#x27;s Degree</h3><p class=\"text-xs text-gray-300 leading-relaxed font-light\">Islamic Studies, Arabic Grammar, or certified equivalent required.</p></div><div class=\"bg-white/5 border border-white/10 rounded-lg p-6\"><span class=\"text-[10px] tracking-widest text-[#C5A059] uppercase block mb-3 font-semibold\">ADMISSIONS LIMIT</span><h3 class=\"text-2xl font-serif text-white font-normal mb-2\">25 Scholars Max</h3><p class=\"text-xs text-gray-300 leading-relaxed font-light\">Maintained tightly for high-fidelity seminar supervision.</p></div></div></div></section><section class=\"py-20 bg-white\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"mb-12\"><div class=\"flex items-center space-x-3 mb-2\"><span class=\"h-px w-8 bg-[#C5A059]\"></span><span class=\"text-xs uppercase tracking-widest text-[#C5A059] font-semibold\">CRITERIA</span></div><h2 class=\"text-2xl sm:text-3xl md:text-4xl font-serif font-normal text-[#1E3E34] mb-3\">Core Admission Requirements</h2><p class=\"text-gray-600 text-sm max-w-3xl font-light\">Scholars applying to the Institute must submit authentic verification documents and meet academic standards to secure selection.</p></div><div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\"><div class=\"border border-gray-200 rounded-lg p-6 bg-white\"><div class=\"flex items-center space-x-3 mb-3\"><span class=\"w-8 h-8 rounded-full bg-emerald-50 text-emerald-700 font-semibold text-xs flex items-center justify-center\">01</span><h3 class=\"text-base font-serif text-[#1E3E34] font-medium\">Official Transcripts</h3></div><p class=\"text-xs text-gray-500 leading-relaxed\">Degree sheets and official seals of previous universities, with accredited Arabic or English translations.</p></div><div class=\"border border-gray-200 rounded-lg p-6 bg-white\"><div class=\"flex items-center space-x-3 mb-3\"><span class=\"w-8 h-8 rounded-full bg-emerald-50 text-emerald-700 font-semibold text-xs flex items-center justify-center\">02</span><h3 class=\"text-base font-serif text-[#1E3E34] font-medium\">Identifications (ID/Passport)</h3></div><p class=\"text-xs text-gray-500 leading-relaxed\">A valid national identification document or passport copy with clear details and photograph.</p></div><div class=\"border border-gray-200 rounded-lg p-6 bg-white\"><div class=\"flex items-center space-x-3 mb-3\"><span class=\"w-8 h-8 rounded-full bg-emerald-50 text-emerald-700 font-semibold text-xs flex items-center justify-center\">03</span><h3 class=\"text-base font-serif text-[#1E3E34] font-medium\">Language Proficiency</h3></div><p class=\"text-xs text-gray-500 leading-relaxed\">Demonstrated fluency in classical Arabic. English standard verification for fellowship candidates.</p></div><div class=\"border border-gray-200 rounded-lg p-6 bg-white\"><div class=\"flex items-center space-x-3 mb-3\"><span class=\"w-8 h-8 rounded-full bg-emerald-50 text-emerald-700 font-semibold text-xs flex items-center justify-center\">04</span><h3 class=\"text-base font-serif text-[#1E3E34] font-medium\">Research Proposal</h3></div><p class=\"text-xs text-gray-500 leading-relaxed\">A comprehensive 1500-word draft detailing research questions, targeted texts, and methodologies (Fellows only).</p></div><div class=\"border border-gray-200 rounded-lg p-6 bg-white\"><div class=\"flex items-center space-x-3 mb-3\"><span class=\"w-8 h-8 rounded-full bg-emerald-50 text-emerald-700 font-semibold text-xs flex items-center justify-center\">05</span><h3 class=\"text-base font-serif text-[#1E3E34] font-medium\">Letters of Recommendation</h3></div><p class=\"text-xs text-gray-500 leading-relaxed\">Two signed academic endorsements from accredited departments confirming historical integrity and drive.</p></div><div class=\"border border-gray-200 rounded-lg p-6 bg-white\"><div class=\"flex items-center space-x-3 mb-3\"><span class=\"w-8 h-8 rounded-full bg-emerald-50 text-emerald-700 font-semibold text-xs flex items-center justify-center\">06</span><h3 class=\"text-base font-serif text-[#1E3E34] font-medium\">Statement of Purpose</h3></div><p class=\"text-xs text-gray-500 leading-relaxed\">A personal letter detailing your academic journey, targets, and reasons for choosing IRITAQ.</p></div></div></div></section><section class=\"py-20 bg-white border-t border-gray-100\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"mb-12\"><div class=\"flex items-center space-x-3 mb-2\"><span class=\"h-px w-8 bg-[#C5A059]\"></span><span class=\"text-xs uppercase tracking-widest text-[#C5A059] font-semibold\">STEPS</span></div><h2 class=\"text-2xl sm:text-3xl md:text-4xl font-serif font-normal text-[#1E3E34] mb-3\">Application Process</h2><p class=\"text-gray-600 text-sm max-w-3xl font-light\">A brief walkthrough of the digital submission steps required to enroll in the current term.</p></div><div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\"><div class=\"border border-gray-200 rounded-lg p-6 bg-white flex flex-col justify-between\"><div><span class=\"text-[11px] font-bold tracking-wider text-[#C5A059] uppercase block mb-3\">STEP 01</span><h3 class=\"text-base font-serif text-[#1E3E34] font-medium mb-3\">Create Account</h3><p class=\"text-xs text-gray-500 leading-relaxed\">Register an applicant account on the official portal using verified contact emails.</p></div></div><div class=\"border border-gray-200 rounded-lg p-6 bg-white flex flex-col justify-between\"><div><span class=\"text-[11px] font-bold tracking-wider text-[#C5A059] uppercase block mb-3\">STEP 02</span><h3 class=\"text-base font-serif text-[#1E3E34] font-medium mb-3\">Fill Forms</h3><p class=\"text-xs text-gray-500 leading-relaxed\">Input details, select target courses, and outline previous scholarly backgrounds carefully.</p></div></div><div class=\"border border-gray-200 rounded-lg p-6 bg-white flex flex-col justify-between\"><div><span class=\"text-[11px] font-bold tracking-wider text-[#C5A059] uppercase block mb-3\">STEP 03</span><h3 class=\"text-base font-serif text-[#1E3E34] font-medium mb-3\">Upload Materials</h3><p class=\"text-xs text-gray-500 leading-relaxed\">Submit high-resolution PDFs of ID sheets, official degree transcripts, and references.</p></div></div><div class=\"border border-gray-200 rounded-lg p-6 bg-white flex flex-col justify-between\"><div><span class=\"text-[11px] font-bold tracking-wider text-[#C5A059] uppercase block mb-3\">STEP 04</span><h3 class=\"text-base font-serif text-[#1E3E34] font-medium mb-3\">Review &amp; Pay</h3><p class=\"text-xs text-gray-500 leading-relaxed\">Double-check overall details, process the digital administrative fee, and receive confirmation.</p></div></div></div></div></section><section id=\"apply\" class=\"py-20 bg-[#FAF7F2] border-t border-b border-[#E8E3DA]\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"mb-10\"><div class=\"flex items-center space-x-3 mb-2\"><span class=\"h-px w-8 bg-[#C5A059]\"></span><span class=\"text-xs uppercase tracking-widest text-[#C5A059] font-semibold\">APPLY NOW</span></div><h2 class=\"text-2xl sm:text-3xl md:text-4xl font-serif font-normal text-[#1E3E34] mb-3\">Digital Admission Form</h2><p class=\"text-gray-600 text-sm max-w-3xl font-light\">Input correct details and secure your scholarly placement file for review by the academic board.</p></div><form class=\"space-y-8 max-w-5xl\"><div><h3 class=\"text-xs font-bold text-emerald-800 tracking-wider uppercase mb-4\">1. PERSONAL INFORMATION</h3><div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\"><div><label class=\"block text-xs font-semibold text-gray-700 mb-1.5\">Full Name</label><input type=\"text\" placeholder=\"e.g. Yahya Al-Mansoor\" class=\"w-full px-4 py-3 bg-white border border-gray-200 rounded text-sm text-gray-800 focus:outline-none focus:border-[#1E3E34]\" name=\"fullName\" value=\"\"/></div><div><label class=\"block text-xs font-semibold text-gray-700 mb-1.5\">Email Address</label><input type=\"email\" placeholder=\"e.g. scholar@domain.com\" class=\"w-full px-4 py-3 bg-white border border-gray-200 rounded text-sm text-gray-800 focus:outline-none focus:border-[#1E3E34]\" name=\"email\" value=\"\"/></div><div><label class=\"block text-xs font-semibold text-gray-700 mb-1.5\">Phone Number</label><input type=\"tel\" placeholder=\"e.g. +91 800 000 0000\" class=\"w-full px-4 py-3 bg-white border border-gray-200 rounded text-sm text-gray-800 focus:outline-none focus:border-[#1E3E34]\" name=\"phone\" value=\"\"/></div><div><label class=\"block text-xs font-semibold text-gray-700 mb-1.5\">Nationality</label><input type=\"text\" placeholder=\"e.g. Indian\" class=\"w-full px-4 py-3 bg-white border border-gray-200 rounded text-sm text-gray-800 focus:outline-none focus:border-[#1E3E34]\" name=\"nationality\" value=\"\"/></div></div></div><div><h3 class=\"text-xs font-bold text-emerald-800 tracking-wider uppercase mb-4\">2. ACADEMIC INFORMATION</h3><div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\"><div><label class=\"block text-xs font-semibold text-gray-700 mb-1.5\">Highest Academic Qualification</label><input type=\"text\" placeholder=\"e.g. Bachelor of Arts in Islamic Studies\" class=\"w-full px-4 py-3 bg-white border border-gray-200 rounded text-sm text-gray-800 focus:outline-none focus:border-[#1E3E34]\" name=\"qualification\" value=\"\"/></div><div><label class=\"block text-xs font-semibold text-gray-700 mb-1.5\">Graduating University / Institution</label><input type=\"text\" placeholder=\"e.g. Al-Jamia Al-Jalaliyya\" class=\"w-full px-4 py-3 bg-white border border-gray-200 rounded text-sm text-gray-800 focus:outline-none focus:border-[#1E3E34]\" name=\"university\" value=\"\"/></div></div></div><div><h3 class=\"text-xs font-bold text-emerald-800 tracking-wider uppercase mb-4\">3. PROGRAM &amp; INTERESTS</h3><div class=\"space-y-4\"><div><label class=\"block text-xs font-semibold text-gray-700 mb-1.5\">Target Admission Program</label><select name=\"targetProgram\" class=\"w-full px-4 py-3 bg-white border border-gray-200 rounded text-sm text-gray-700 focus:outline-none focus:border-[#1E3E34]\"><option value=\"\" disabled=\"\" selected=\"\">Select e.g. Master of Qur&#x27;anic Sciences</option><option value=\"masters\">Master of Qur&#x27;anic Sciences</option><option value=\"cert\">Certificate Programs</option><option value=\"diploma\">Diploma Programs</option><option value=\"fellowship\">Research Fellowships</option></select></div><div><label class=\"block text-xs font-semibold text-gray-700 mb-1.5\">Core Research Interests</label><textarea rows=\"4\" name=\"researchInterests\" placeholder=\"Outline targeted commentators, eras, or Arabic linguistic frameworks of interest...\" class=\"w-full px-4 py-3 bg-white border border-gray-200 rounded text-sm text-gray-800 focus:outline-none focus:border-[#1E3E34] resize-y\"></textarea></div></div></div><div class=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-2\"><label class=\"flex items-center space-x-2.5 cursor-pointer\"><input type=\"checkbox\" class=\"w-4 h-4 text-[#1E3E34] rounded border-gray-300 focus:ring-[#1E3E34]\" name=\"declaration\"/><span class=\"text-xs text-gray-600 font-medium\">I hereby declare that all submitted academic and personal records are authentic.</span></label><button type=\"submit\" class=\"px-7 py-3.5 bg-[#21674E] hover:bg-[#1B543F] text-white text-xs font-bold rounded transition-colors duration-200 whitespace-nowrap\">Submit Secure Application</button></div></form></div></section><section class=\"py-20 bg-white\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"mb-12\"><div class=\"flex items-center space-x-3 mb-2\"><span class=\"h-px w-8 bg-[#C5A059]\"></span><span class=\"text-xs uppercase tracking-widest text-[#C5A059] font-semibold\">SCHEDULE</span></div><h2 class=\"text-2xl sm:text-3xl md:text-4xl font-serif font-normal text-[#1E3E34] mb-3\">Key Enrollment Deadlines</h2><p class=\"text-gray-600 text-sm max-w-3xl font-light\">Review our annual milestone dates carefully to ensure timely evaluation of your dossier.</p></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\"><div class=\"border border-gray-200 rounded-lg p-6 bg-white\"><span class=\"text-[11px] font-bold tracking-wider text-[#C5A059] uppercase block mb-4\">JANUARY TERM</span><div class=\"space-y-4\"><div class=\"flex justify-between items-center text-xs pb-3 border-b border-gray-100\"><span class=\"text-gray-600\">Admissions Open:</span><span class=\"font-bold text-[#1E3E34]\">January 01, 2026</span></div><div class=\"flex justify-between items-center text-xs pb-3 border-b border-gray-100\"><span class=\"text-gray-600\">Early Action Deadline:</span><span class=\"font-bold text-[#1E3E34]\">February 28, 2026</span></div><div class=\"flex justify-between items-center text-xs \"><span class=\"text-gray-600\">General Deadline:</span><span class=\"font-bold text-[#1E3E34]\">March 15, 2026</span></div></div></div><div class=\"border border-gray-200 rounded-lg p-6 bg-white\"><span class=\"text-[11px] font-bold tracking-wider text-[#C5A059] uppercase block mb-4\">INTERVIEWS &amp; INTAKE</span><div class=\"space-y-4\"><div class=\"flex justify-between items-center text-xs pb-3 border-b border-gray-100\"><span class=\"text-gray-600\">Scholarly Interviews:</span><span class=\"font-bold text-[#1E3E34]\">April 1–15, 2026</span></div><div class=\"flex justify-between items-center text-xs pb-3 border-b border-gray-100\"><span class=\"text-gray-600\">Final Decisions Out:</span><span class=\"font-bold text-[#1E3E34]\">May 01, 2026</span></div><div class=\"flex justify-between items-center text-xs \"><span class=\"text-gray-600\">Classes Inauguration:</span><span class=\"font-bold text-[#1E3E34]\">September 01, 2026</span></div></div></div></div></div></section><section class=\"py-20 bg-white border-t border-gray-100\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"mb-12\"><div class=\"flex items-center space-x-3 mb-2\"><span class=\"h-px w-8 bg-[#C5A059]\"></span><span class=\"text-xs uppercase tracking-widest text-[#C5A059] font-semibold\">SUPPORT</span></div><h2 class=\"text-2xl sm:text-3xl md:text-4xl font-serif font-normal text-[#1E3E34] mb-3\">Frequently Asked Questions</h2><p class=\"text-gray-600 text-sm max-w-3xl font-light\">Common inquiries from incoming scholars seeking admission to IRITAQ.</p></div><div class=\"space-y-4 max-w-5xl\"><div class=\"border border-gray-200 rounded-lg p-5 bg-white\"><button class=\"w-full flex justify-between items-center text-left font-serif text-[#1E3E34] text-sm sm:text-base font-medium focus:outline-none\"><span>Can I apply for multiple programs simultaneously?</span><span class=\"transition-transform duration-200 text-[#C5A059] ml-2 \"><svg fill=\"none\" height=\"18\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewBox=\"0 0 24 24\" width=\"18\"><polyline points=\"6 9 12 15 18 9\"></polyline></svg></span></button></div><div class=\"border border-gray-200 rounded-lg p-5 bg-white\"><button class=\"w-full flex justify-between items-center text-left font-serif text-[#1E3E34] text-sm sm:text-base font-medium focus:outline-none\"><span>Is financial aid or full scholarship support available?</span><span class=\"transition-transform duration-200 text-[#C5A059] ml-2 \"><svg fill=\"none\" height=\"18\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewBox=\"0 0 24 24\" width=\"18\"><polyline points=\"6 9 12 15 18 9\"></polyline></svg></span></button></div></div></div></section></div><!--$--><!--/$--></main><footer class=\"w-full bg-[#111613] text-[#cfd4cf] font-sans border-t border-[#1e2520]\"><div class=\"max-w-7xl mx-auto px-6 md:px-16 pt-16 pb-12\"><div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 pb-14 border-b border-[#1e2520]\"><div class=\"lg:col-span-1 space-y-5\"><div class=\"relative w-36 h-14\"><img alt=\"IRITAQ Logo\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain brightness-0 invert\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Flogo-iritaq.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Flogo-iritaq.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Flogo-iritaq.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Flogo-iritaq.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Flogo-iritaq.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Flogo-iritaq.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Flogo-iritaq.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Flogo-iritaq.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Flogo-iritaq.png&amp;w=3840&amp;q=75\"/></div><h2 class=\"text-white font-serif font-light text-xl md:text-2xl leading-tight\">International Research Institute for Tafsir Al-Qur&#x27;an</h2><p class=\"text-xs text-[#9da39d] font-light leading-relaxed\">Advancing authentic Qur&#x27;anic scholarship through research, publication and international collaboration.</p><div class=\"flex items-center gap-3 pt-2\"><a href=\"https://facebook.com\" target=\"_blank\" rel=\"noreferrer\" class=\"w-9 h-9 rounded-lg bg-white hover:bg-slate-200 flex items-center justify-center text-slate-950 transition shadow-xs\" aria-label=\"Facebook\"><span class=\"text-xs font-bold text-slate-950\">f</span></a><a href=\"https://linkedin.com\" target=\"_blank\" rel=\"noreferrer\" class=\"w-9 h-9 rounded-lg bg-white hover:bg-slate-200 flex items-center justify-center text-slate-950 transition shadow-xs\" aria-label=\"LinkedIn\"><span class=\"text-xs font-bold text-slate-950\">in</span></a><a href=\"https://twitter.com\" target=\"_blank\" rel=\"noreferrer\" class=\"w-9 h-9 rounded-lg bg-white hover:bg-slate-200 flex items-center justify-center text-slate-950 transition shadow-xs\" aria-label=\"Twitter / X\"><span class=\"text-xs font-bold text-slate-950\">𝕏</span></a><a href=\"https://youtube.com\" target=\"_bl